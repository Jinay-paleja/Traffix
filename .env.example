SECRET_KEY=change-me

# Firebase Admin SDK credentials (backend)
# Option 1: path to the downloaded service-account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./your-project-firebase-adminsdk.json
# Option 2: raw JSON string (use instead of FIREBASE_SERVICE_ACCOUNT_PATH)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Firebase Web app config (frontend auth)
FIREBASE_WEB_API_KEY=your-api-key
FIREBASE_WEB_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=your-project-id
FIREBASE_WEB_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_WEB_MESSAGING_SENDER_ID=1234567890
FIREBASE_WEB_APP_ID=1:1234567890:web:abc123
FIREBASE_WEB_MEASUREMENT_ID=G-XXXXXXXXXX
